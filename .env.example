# ==============================================================================
# КОНФИГУРАЦИЯ API И КЛЮЧЕЙ ДЛЯ LIVE-ТОРГОВЛИ НА BITGET
# Скопируйте этот файл в .env и укажите ваши реальные/демо ключи:
# cp .env.example .env
# ==============================================================================

# --- Bitget API Credentials ---
# Получить в личном кабинете Bitget -> Профиль -> Управление API:
# Для демо-трейдинга включите флаг Демо-трейдинг (V-трейдинг) или создайте API-ключ.
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_API_PASSWORD=your_bitget_api_passphrase_here

# --- Google Gemini API (опционально, для ИИ-оценки сделок) ---
# Получить бесплатно на https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Режим торговли ---
# True = Демо-счет (PAPTRADING, безопасное тестирование без риска потери денег)
# False = РЕАЛЬНЫЙ СЧЁТ (требует подтверждения "ДА" в терминале)
DEMO_MODE=True

# --- Дисциплина и Риск-менеджмент (Prop-Firm Grade) ---
# Риск на сделку в % от текущего баланса депозита (по умолчанию 1.0%, агрессивно до 5.0%)
RISK_PER_TRADE_PCT=1.0
LEVERAGE=3

# --- T-Bank Invest API (Т-Инвестиции / Мосбиржа) ---
# Получить в ЛК Т-Банка: Инвестиции -> Настройки -> Доступ к API -> Токен для T-Invest API
# (Для тестов можно выпустить токен для песочницы или полный токен)
TBANK_TOKEN=your_tbank_token_here
TBANK_ACCOUNT_ID=
TBANK_SANDBOX=True
TBANK_TICKER=SBER
TBANK_CLASS_CODE=TQBR
SSL_TBANK_VERIFY=True

